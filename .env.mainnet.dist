# Production (mainnet) build values, baked into the Docker image at build time.
# Every NEXT_PUBLIC_* value is public by definition — it is inlined into the
# client bundle. No secrets belong in this file.
NEXT_PUBLIC_CHAIN_ID=beezee-1
NEXT_PUBLIC_CHAIN_NAME="beezee"
NEXT_PUBLIC_REST_URL=https://rest.getbze.com
NEXT_PUBLIC_RPC_URL=wss://rpc.getbze.com
NEXT_PUBLIC_AGG_API_HOST=https://getbze.com
NEXT_PUBLIC_CHAIN_REGISTRY_ASSETS_URL=https://raw.githubusercontent.com/cosmos/chain-registry/master/beezee/assetlist.json
NEXT_PUBLIC_RPC_URL_ARCHWAY=wss://rpc-archway.mzonder.com
NEXT_PUBLIC_RPC_URL_OSMOSIS=wss://rpc.osmosis.chaintools.tech
NEXT_PUBLIC_RPC_URL_NOBLE=wss://rpc-noble.keplr.app
